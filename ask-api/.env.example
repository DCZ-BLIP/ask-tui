# ===== ask-api 环境变量配置 =====
# 复制此文件为 .env 并修改对应值
# 部署到 Render 时在控制台 Environment 中配置相同变量

# ===== 基础配置 =====
APP_NAME=ask-api
APP_VERSION=0.3.0
DEBUG=True

# ===== 数据库配置 =====
# 开发用 SQLite 文件，生产环境建议用绝对路径
DATABASE_URL=sqlite+aiosqlite:///./ask_api.db

# ===== 数据回收 =====
MESSAGE_RETENTION_DAYS=7
CLEANUP_INTERVAL_HOURS=24

# ===== 安全配置 =====
DAILY_REQUEST_LIMIT=200
ADMIN_API_KEY=ask-admin-secret
RATE_LIMIT_ENABLED=True

# ===== AI 模型配置 =====
# 智谱 GLM-4-Flash（免费模型）
# 获取 API Key: https://bigmodel.cn/usercenter/proj-mgmt/apikeys
LLM_MODEL=glm-4-flash-250414
LLM_API_KEY=你的智谱API密钥
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 生产环境注意事项 =====
# 1. DEBUG 设为 False
# 2. ADMIN_API_KEY 改为随机字符串（建议 32 位以上）
# 3. DATABASE_URL 使用持久化存储路径
# 4. LLM_API_KEY 填入智谱真实密钥
